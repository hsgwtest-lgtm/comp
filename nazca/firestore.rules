rules_version = '2';

// nazca — Cloud Firestore セキュリティルール
// ・閲覧・投稿は匿名ログイン済みのユーザーのみ
// ・SKETCH-ONLY 投稿は緯度経度（geo / view）を含められない（位置情報をサーバーに残さない）
// ・view は MAP MODE の作品の表示（中心の緯度経度と向き）
// ・投稿の編集はリアクション（reactions）の更新のみ。削除は投稿者本人のみ
// ・pts / sizeM は総合ポイントと絵の大きさ（v2.2）。theme は笑顔のお題（'smile' のみ）
// ・smile_posts は撮影した「顔に見えるモノ」（64×64 のドット絵）。gallery 公開は位置情報（pos）を含められない
// ・smile_log は笑顔の回数の記録（追記専用。ドキュメント ID = 投稿 ID なので二重に数えない。本人の投稿がある記録だけ作れる）
// ・文字数の上限はアプリ側（名前10字・タイトル20字）で管理し、ここでは大きめの安全上限だけを設ける
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isValidShape(d) {
      return d.shape is list && d.shape.size() >= 1 && d.shape.size() <= 60;
    }

    // 公開モードと位置情報の整合性
    function isValidPublish(d) {
      return (d.publish == 'sketch' && !d.keys().hasAny(['geo']))
          || (d.publish == 'map' && d.geo is list && d.geo.size() >= 1 && d.geo.size() <= 60);
    }

    // 作品の表示（中心・向き）。MAP MODE のみ
    function isValidView(d) {
      return !d.keys().hasAny(['view'])
          || (d.publish == 'map'
              && d.view is map
              && d.view.keys().hasOnly(['lat', 'lng', 'rot'])
              && d.view.lat is number && d.view.lat >= -90 && d.view.lat <= 90
              && d.view.lng is number && d.view.lng >= -180 && d.view.lng <= 180
              && d.view.rot is number && d.view.rot >= -180 && d.view.rot <= 180);
    }

    function isValidBase(d) {
      return d.uid == request.auth.uid
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
          && d.distance is number && d.distance >= 0 && d.distance <= 200000
          && d.duration is number && d.duration >= 0
          && d.reactions == {}
          && d.createdAt == request.time
          && isValidShape(d)
          && isValidPublish(d)
          && isValidView(d);
    }

    // 任意の数値項目（無いか、範囲内の数値）
    function optNumber(d, k, lo, hi) {
      return !d.keys().hasAny([k]) || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }

    function validReactionsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.keys().hasOnly(['like', 'star', 'oneup', 'gg']);
    }

    match /daily_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'uid', 'name', 'publish', 'distance', 'duration', 'shape', 'geo', 'view', 'v',
                                                  'dayKey', 'challengeId', 'challengeName', 'score', 'pts', 'sizeM', 'theme', 'reactions', 'createdAt'])
        && request.resource.data.kind == 'daily'
        && isValidBase(request.resource.data)
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.dayKey is string
        && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.challengeId is string && request.resource.data.challengeId.size() <= 40
        && optNumber(request.resource.data, 'pts', 0, 2000)
        && optNumber(request.resource.data, 'sizeM', 0, 1000000)
        && (!request.resource.data.keys().hasAny(['theme']) || request.resource.data.theme == 'smile');
      allow update: if signedIn() && validReactionsUpdate();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /free_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'uid', 'name', 'publish', 'distance', 'duration', 'shape', 'geo', 'view', 'v',
                                                  'title', 'reactions', 'createdAt'])
        && request.resource.data.kind == 'free'
        && isValidBase(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() <= 80;
      allow update: if signedIn() && validReactionsUpdate();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 撮影した笑顔（顔に見えるモノ）
    match /smile_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'uid', 'name', 'title', 'comment', 'pixels', 'pal', 'publish', 'pos', 'reactions', 'v', 'createdAt'])
        && request.resource.data.kind == 'smile'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && (!request.resource.data.keys().hasAny(['title']) || (request.resource.data.title is string && request.resource.data.title.size() <= 80))
        && (!request.resource.data.keys().hasAny(['comment']) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 160))
        && request.resource.data.pixels is string && request.resource.data.pixels.size() >= 100 && request.resource.data.pixels.size() <= 3000
        && request.resource.data.pal is number
        && request.resource.data.reactions == {}
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.publish == 'gallery' && !request.resource.data.keys().hasAny(['pos']))
            || (request.resource.data.publish == 'map'
                && request.resource.data.pos is map
                && request.resource.data.pos.keys().hasOnly(['lat', 'lng'])
                && request.resource.data.pos.lat is number && request.resource.data.pos.lat >= -90 && request.resource.data.pos.lat <= 90
                && request.resource.data.pos.lng is number && request.resource.data.pos.lng >= -180 && request.resource.data.pos.lng <= 180));
      allow update: if signedIn() && validReactionsUpdate();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // smile_log の記録は、本人の実際の投稿 1 件につき 1 件だけ（ID = 投稿 ID）
    // found: 撮影した笑顔（smile_posts）
    // geoglyph: 笑顔のお題の DAILY 作品（theme == 'smile'、または組み込みの笑顔のお題 smile-NN）。dayKey は投稿と同じ日
    function ownSmilePhoto(id) {
      return exists(/databases/$(database)/documents/smile_posts/$(id))
          && get(/databases/$(database)/documents/smile_posts/$(id)).data.uid == request.auth.uid;
    }
    function isSmileDaily(p) {
      return (p.keys().hasAny(['theme']) && p.theme == 'smile') || p.challengeId.matches('^smile-[0-9]+$');
    }
    function ownSmileGeoglyph(id, d) {
      return exists(/databases/$(database)/documents/daily_posts/$(id))
          && get(/databases/$(database)/documents/daily_posts/$(id)).data.uid == request.auth.uid
          && isSmileDaily(get(/databases/$(database)/documents/daily_posts/$(id)).data)
          && d.keys().hasAny(['dayKey'])
          && d.dayKey == get(/databases/$(database)/documents/daily_posts/$(id)).data.dayKey;
    }

    // 笑顔の回数の記録（追記専用。投稿を消しても記録は残る）
    match /smile_log/{logId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'refId', 'dayKey', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['geoglyph', 'found']
        && request.resource.data.refId == logId
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['dayKey']) || request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && ((request.resource.data.type == 'found' && !request.resource.data.keys().hasAny(['dayKey']) && ownSmilePhoto(logId))
            || (request.resource.data.type == 'geoglyph' && ownSmileGeoglyph(logId, request.resource.data)));
      allow update, delete: if false;
    }

    // お題の上書き（管理者が Firebase コンソールから作成）
    match /challenges/{dayKey} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40;
    }
  }
}
